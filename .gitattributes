# Normalize detected text to LF in both the index and working tree.
* text=auto eol=lf

# Native Windows command scripts require CRLF checkouts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets byte-for-byte unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.br binary
