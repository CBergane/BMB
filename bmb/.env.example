SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
# Local hosts only by default; production must explicitly set:
# ALLOWED_HOSTS=bramycketbattre.com,www.bramycketbattre.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# False for the private compose PostgreSQL service without TLS. Use True
# when connecting to a TLS-enabled database, especially across public networks.
DATABASE_SSL=False
DATABASE_URL=postgresql://bmb:replace-with-a-strong-password@db:5432/bmb
CART_SESSION=cart

# Local HTTP defaults. In production, list the public HTTPS origins separated
# by commas and set the three secure flags to True.
# CSRF_TRUSTED_ORIGINS=https://bramycketbattre.com,https://www.bramycketbattre.com
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS is disabled locally. In production, start with SECURE_HSTS_SECONDS=300
# after verifying HTTPS through the proxy; increase gradually once validated.
# Enable includeSubDomains only when every subdomain supports HTTPS.
# Preload is a separate operational decision; do not enable automatically.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# The trusted reverse proxy must overwrite X-Forwarded-Proto and
# X-Forwarded-Host, reflecting the original HTTPS scheme and public hostname.
# Keep the web port bound to loopback as in compose.yaml.

CLOUD_NAME=
API_KEY=
API_SECRET=

STRIPE_API_KEY=
STRIPE_API_KEY_HIDDEN=

EMAIL=
EPASSWORD=
# Optional: defaults to EMAIL. Use an address authorized by the SMTP account.
DEFAULT_FROM_EMAIL=

POSTGRES_DB=bmb
POSTGRES_USER=bmb
POSTGRES_PASSWORD=replace-with-a-strong-password
